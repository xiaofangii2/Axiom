#!/bin/sh
# Axiom - 本地语料 + 历史 + 多服务商 API

AXIOM_DIR="$HOME/.axiom"
BRAIN_DIR="$AXIOM_DIR/brain"
INI="$AXIOM_DIR/Online-AI.ini"
CURRENT="$AXIOM_DIR/current"
HISTORY="$AXIOM_DIR/history"
MODEL_NAME="Axiom"

mkdir -p "$BRAIN_DIR"
touch "$INI"

show_help() {
  echo "Axiom - 一个还没训练的小模型"
  echo ""
  echo "  Axiom help                       显示帮助"
  echo "  Axiom chat                       进入本地聊天"
  echo "  Axiom chat api                   用选中的服务商聊天"
  echo "  Axiom api <ID>                   添加服务商"
  echo "  Axiom api edit <ID>              编辑服务商"
  echo "  Axiom api rm <ID>                删除服务商"
  echo "  Axiom model                      列出服务商和模型"
  echo "  Axiom model <ID> <模型名>        切换当前服务商+模型"
  echo "  Axiom train <输入> :: <回复>     教它一句"
  echo "  Axiom brain                      看看学了啥"
  echo "  Axiom forget <输入>              忘掉一条"
  echo "  Axiom history                    看聊天记录"
  echo "  Axiom import <brain.tar.gz>      导入语料包"
  echo "  Axiom export [文件]              导出语料为 brain.tar.gz"
  echo ""
  echo "协议类型 type: openai / gemini / ollama"
}

# ===== 训练 =====
train_mode() {
  line="$*"
  case "$line" in
    *"::"*)
      input="${line%%::*}"
      reply="${line#*::}"
      input=$(echo "$input" | sed 's/^ *//;s/ *$//')
      reply=$(echo "$reply" | sed 's/^ *//;s/ *$//')
      [ -z "$input" ] && { echo "Axiom: 输入不能为空"; return; }
      [ -z "$reply" ] && { echo "Axiom: 回复不能为空"; return; }
      fname=$(printf '%s' "$input" | sed 's|/|_|g' | tr 'A-Z' 'a-z')
      printf '%s' "$reply" > "$BRAIN_DIR/$fname"
      echo "Axiom: 学会了 —— 「$fname」→「$reply」"
      ;;
    *)
      echo "Axiom: 格式不对，例如："
      echo "  Axiom train 你好 :: 你好啊"
      ;;
  esac
}

brain_mode() {
  echo "Axiom 学过的东西："
  count=0
  for f in "$BRAIN_DIR"/*; do
    [ -e "$f" ] || continue
    echo "  「$(basename "$f")」→「$(cat "$f")」"
    count=$((count + 1))
  done
  echo ""
  echo "共 $count 条"
}

forget_mode() {
  key="$*"
  [ -z "$key" ] && { echo "Axiom: 用法：Axiom forget <输入>"; return; }
  key_lower=$(printf '%s' "$key" | tr 'A-Z' 'a-z')
  f="$BRAIN_DIR/$key_lower"
  if [ -f "$f" ]; then
    rm -f "$f"
    echo "Axiom: 忘掉了 —— 「$key_lower」"
  else
    echo "Axiom: 没找到「$key」"
  fi
}

local_lookup() {
  inp_lower=$(printf '%s' "$1" | tr 'A-Z' 'a-z')
  f="$BRAIN_DIR/$inp_lower"
  if [ -f "$f" ]; then
    cat "$f"; return 0
  fi
  return 1
}

log_history() {
  ts=$(date "+%Y-%m-%d %H:%M:%S")
  printf '[%s] 你: %s\n' "$ts" "$1" >> "$HISTORY"
  printf '[%s] Axiom: %s\n' "$ts" "$2" >> "$HISTORY"
}

history_mode() {
  [ -f "$HISTORY" ] && cat "$HISTORY" || echo "Axiom: 还没有聊天记录"
}

# ===== 校验：只含数字或英文 =====
is_alnum() {
  case "$1" in
    *[!0-9A-Za-z]*) return 1 ;;
    "") return 1 ;;
    *) return 0 ;;
  esac
}

# ===== 读 META 字段 =====
meta_get() {
  file="$1"; key="$2"
  [ -f "$file" ] || return 1
  awk -v key="$key" '
    {
      line = $0
      gsub(/^[[:space:]]+/, "", line)
      gsub(/[[:space:]]+$/, "", line)
      pos = index(line, "=")
      if (pos > 0) {
        k = substr(line, 1, pos - 1)
        v = substr(line, pos + 1)
        gsub(/^[[:space:]]+/, "", k); gsub(/[[:space:]]+$/, "", k)
        gsub(/^[[:space:]]+/, "", v); gsub(/[[:space:]]+$/, "", v)
        if (k == key) { print v; exit }
      }
    }
  ' "$file"
}

# ===== 导出语料包 =====
export_mode() {
  out="$1"
  [ -z "$out" ] && out="brain.tar.gz"

  n=0
  for f in "$BRAIN_DIR"/*; do
    [ -e "$f" ] && n=$((n+1))
  done
  if [ "$n" -eq 0 ]; then
    echo "Axiom: 没有语料可导出"
    return
  fi

  # id：只允许数字英文
  while :; do
    printf "id（数字或英文）: "
    read pid
    if is_alnum "$pid"; then
      break
    fi
    echo "Axiom: id 只能包含数字和英文，请重输"
  done

  printf "author（回车默认 unknown）: "
  read pauthor
  [ -z "$pauthor" ] && pauthor="unknown"

  printf "version（回车默认 1.0.0）: "
  read pver
  [ -z "$pver" ] && pver="1.0.0"

  ptime=$(date "+%Y-%m-%d %H:%M:%S")

  # 转绝对路径
  case "$out" in
    /*) ;;
    *)  out="$(pwd)/$out" ;;
  esac

  tmp=$(mktemp -d)
  cp -r "$BRAIN_DIR" "$tmp/brain"
  {
    printf 'id = %s\n' "$pid"
    printf 'author = %s\n' "$pauthor"
    printf 'version = %s\n' "$pver"
    printf 'count = %s\n' "$n"
    printf 'time = %s\n' "$ptime"
  } > "$tmp/META"

  (cd "$tmp" && tar -czf "$out" brain META) || {
    echo "Axiom: 打包失败"
    rm -rf "$tmp"
    return
  }
  rm -rf "$tmp"

  echo "Axiom: 已导出 $n 条语料 → $out"
  echo "  id:      $pid"
  echo "  author:  $pauthor"
  echo "  version: $pver"
  echo "  time:    $ptime"
}

# ===== 导入语料包 =====
import_mode() {
  src="$1"
  [ -z "$src" ] && { echo "Axiom: 用法：Axiom import <brain.tar.gz>"; return; }
  [ -f "$src" ] || { echo "Axiom: 找不到文件 $src"; return; }

  case "$src" in
    *.tar.gz|*.tgz) ;;
    *) echo "Axiom: 只支持 .tar.gz 或 .tgz"; return ;;
  esac

  tmp=$(mktemp -d)
  tar -xzf "$src" -C "$tmp" || { echo "Axiom: 解压失败"; rm -rf "$tmp"; return; }

  if [ -d "$tmp/brain" ]; then
    src_brain="$tmp/brain"
  else
    n=$(ls -A "$tmp" | wc -l)
    if [ "$n" -eq 1 ]; then
      only=$(ls -A "$tmp")
      if [ -d "$tmp/$only/brain" ]; then
        src_brain="$tmp/$only/brain"
        metafile="$tmp/$only/META"
      fi
    fi
  fi
  [ -z "$metafile" ] && metafile="$tmp/META"

  if [ -z "$src_brain" ] || [ ! -d "$src_brain" ]; then
    echo "Axiom: 压缩包里没有 brain/ 目录"
    rm -rf "$tmp"
    return
  fi

  # 校验 META
  if [ ! -f "$metafile" ]; then
    echo "Axiom: 缺少 META 文件，包不合法"
    rm -rf "$tmp"
    return
  fi

  mid=$(meta_get "$metafile" "id")
  mauthor=$(meta_get "$metafile" "author")
  mver=$(meta_get "$metafile" "version")
  mcount=$(meta_get "$metafile" "count")
  mtime=$(meta_get "$metafile" "time")

  if ! is_alnum "$mid"; then
    echo "Axiom: META 里 id 不合法（只能数字或英文）"
    rm -rf "$tmp"
    return
  fi
  if [ -z "$mauthor" ] || [ -z "$mver" ]; then
    echo "Axiom: META 缺少 author 或 version"
    rm -rf "$tmp"
    return
  fi
  case "$mcount" in
    ""|*[!0-9]*)
      echo "Axiom: META 里 count 不是数字"
      rm -rf "$tmp"
      return
      ;;
  esac

  echo "包信息："
  echo "  ID:       $mid"
  echo "  作者:     $mauthor"
  echo "  版本:     $mver"
  echo "  条数:     $mcount"
  echo "  导出时间: $mtime"
  echo ""

  count_new=0
  count_over=0
  count_skip=0
  all=""

  for f in "$src_brain"/*; do
    [ -f "$f" ] || continue
    name=$(basename "$f")
    name_lower=$(printf '%s' "$name" | tr 'A-Z' 'a-z')
    dst="$BRAIN_DIR/$name_lower"

    if [ -f "$dst" ]; then
      if [ "$all" = "over" ]; then
        cp "$f" "$dst"; count_over=$((count_over+1)); continue
      fi
      if [ "$all" = "skip" ]; then
        count_skip=$((count_skip+1)); continue
      fi

      echo "检测到同文件：$name_lower"
      echo "请选择："
      echo "  1 覆盖"
      echo "  2 跳过"
      echo "  3 全部覆盖"
      echo "  4 全部跳过"
      printf "> "
      read choice
      case "$choice" in
        1) cp "$f" "$dst"; count_over=$((count_over+1)) ;;
        2) count_skip=$((count_skip+1)) ;;
        3) all="over"; cp "$f" "$dst"; count_over=$((count_over+1)) ;;
        4) all="skip"; count_skip=$((count_skip+1)) ;;
        *) echo "Axiom: 无效选择，跳过"; count_skip=$((count_skip+1)) ;;
      esac
    else
      cp "$f" "$dst"
      count_new=$((count_new+1))
    fi
  done

  rm -rf "$tmp"

  echo "Axiom: 导入完成"
  echo "  新增: $count_new"
  echo "  覆盖: $count_over"
  echo "  跳过: $count_skip"
}

# ===== INI 读取 =====
ini_get() {
  awk -v id="$1" -v key="$2" '
    BEGIN { inblock = 0 }
    /^[[:space:]]*\[/ {
      gsub(/^[[:space:]]*\[/, "")
      gsub(/\][[:space:]]*$/, "")
      inblock = ($0 == id) ? 1 : 0
      next
    }
    inblock {
      line = $0
      gsub(/^[[:space:]]+/, "", line)
      gsub(/[[:space:]]+$/, "", line)
      pos = index(line, "=")
      if (pos > 0) {
        k = substr(line, 1, pos - 1)
        v = substr(line, pos + 1)
        gsub(/^[[:space:]]+/, "", k); gsub(/[[:space:]]+$/, "", k)
        gsub(/^[[:space:]]+/, "", v); gsub(/[[:space:]]+$/, "", v)
        if (k == key) { print v; exit }
      }
    }
  ' "$INI"
}

ini_exists() {
  awk -v id="$1" '
    /^[[:space:]]*\[/ {
      gsub(/^[[:space:]]*\[/, "")
      gsub(/\][[:space:]]*$/, "")
      if ($0 == id) { print "yes"; exit }
    }
  ' "$INI" | grep -q yes
}

ini_delete() {
  awk -v id="$1" '
    BEGIN { inblock = 0 }
    /^[[:space:]]*\[/ {
      line = $0
      gsub(/^[[:space:]]*\[/, "", line)
      gsub(/\][[:space:]]*$/, "", line)
      if (line == id) { inblock = 1; next }
      else { inblock = 0 }
    }
    !inblock { print }
  ' "$INI" > "$INI.tmp" && mv "$INI.tmp" "$INI"
}

ini_write() {
  id="$1"; url="$2"; token="$3"; models="$4"; type="$5"
  {
    printf '[%s]\n' "$id"
    printf 'api_url = %s\n' "$url"
    printf 'token = %s\n' "$token"
    printf 'models = %s\n' "$models"
    printf 'type = %s\n' "$type"
    printf '\n'
  } >> "$INI"
}

ini_list_ids() {
  awk '
    /^[[:space:]]*\[/ {
      gsub(/^[[:space:]]*\[/, "")
      gsub(/\][[:space:]]*$/, "")
      print
    }
  ' "$INI"
}

# ===== 当前选中 =====
load_current() {
  [ -f "$CURRENT" ] || return 1
  CUR_ID=$(sed -n '1p' "$CURRENT")
  CUR_MODEL=$(sed -n '2p' "$CURRENT")
  [ -n "$CUR_ID" ] && [ -n "$CUR_MODEL" ]
}

# ===== 调 API =====
ask_api() {
  inp="$1"
  if ! load_current; then
    echo "Axiom: 还没选服务商，先 Axiom model <ID> <模型>" >&2
    return 1
  fi
  url=$(ini_get "$CUR_ID" "api_url")
  token=$(ini_get "$CUR_ID" "token")
  type=$(ini_get "$CUR_ID" "type")
  [ -z "$type" ] && type="openai"
  if [ -z "$url" ]; then
    echo "Axiom: 服务商 $CUR_ID 没有 api_url" >&2
    return 1
  fi

  case "$type" in
    gemini)
      full_url="$url/$CUR_MODEL:generateContent"
      json=$(jq -n --arg c "$inp" \
        '{contents:[{role:"user",parts:[{text:$c}]}]}')
      response=$(curl -s -X POST "$full_url" \
        -H "x-goog-api-key: $token" \
        -H "Content-Type: application/json" \
        -d "$json")
      echo "$response" | jq -r '.candidates[0].content.parts[0].text // empty'
      ;;
    ollama)
      json=$(jq -n --arg m "$CUR_MODEL" --arg c "$inp" \
        '{model:$m, messages:[{role:"user",content:$c}], stream:false}')
      response=$(curl -s -X POST "$url" \
        -H "Content-Type: application/json" \
        -d "$json")
      echo "$response" | jq -r '.message.content // empty'
      ;;
    *)
      json=$(jq -n --arg m "$CUR_MODEL" --arg c "$inp" \
        '{model:$m, messages:[{role:"user", content:$c}]}')
      if [ -n "$token" ]; then
        response=$(curl -s -X POST "$url" \
          -H "Authorization: Bearer $token" \
          -H "Content-Type: application/json" \
          -d "$json")
      else
        response=$(curl -s -X POST "$url" \
          -H "Content-Type: application/json" \
          -d "$json")
      fi
      echo "$response" | jq -r '.choices[0].message.content // empty'
      ;;
  esac
}

# ===== 本地聊天 =====
chat_local() {
  echo "Axiom: 已进入本地聊天模式（Ctrl+C 退出）"
  while true; do
    printf "你: "
    read input
    [ -z "$input" ] && continue
    if out=$(local_lookup "$input"); then
      echo "Axiom: $out"; log_history "$input" "$out"
    else
      echo "Axiom: 未训练"; log_history "$input" "未训练"
    fi
  done
}

# ===== API 聊天 =====
chat_api() {
  if ! load_current; then
    echo "Axiom: 还没选服务商，先 Axiom model <ID> <模型>"
    return 1
  fi
  echo "Axiom: API 聊天（服务商: $CUR_ID / 模型: $CUR_MODEL）"
  echo "Axiom: Ctrl+C 退出"
  while true; do
    printf "你: "
    read input
    [ -z "$input" ] && continue
    if out=$(local_lookup "$input"); then
      echo "Axiom: $out"; log_history "$input" "$out"
    else
      reply=$(ask_api "$input")
      if [ -n "$reply" ]; then
        echo "Axiom: $reply"; log_history "$input" "$reply"
      else
        echo "Axiom: API 无响应"
      fi
    fi
  done
}

# ===== 添加服务商 =====
api_add() {
  id="$1"
  [ -z "$id" ] && { echo "Axiom: 用法：Axiom api <ID>"; return; }

  if ini_exists "$id"; then
    echo "Axiom: 已有同名服务商「$id」，不做任何事"
    return
  fi

  printf "协议类型（openai/gemini/ollama，回车默认 openai）: "
  read type
  [ -z "$type" ] && type="openai"

  printf "api_url: "
  read url
  [ -z "$url" ] && { echo "Axiom: url 不能为空"; return; }

  printf "token（可空，Ollama 直接回车）: "
  read token

  printf "models（逗号分隔）: "
  read models
  [ -z "$models" ] && { echo "Axiom: 至少一个模型"; return; }

  ini_write "$id" "$url" "$token" "$models" "$type"
  echo "Axiom: 已保存服务商「$id」（type=$type）"
}

# ===== 编辑服务商 =====
api_edit() {
  id="$1"
  [ -z "$id" ] && { echo "Axiom: 用法：Axiom api edit <ID>"; return; }
  if ! ini_exists "$id"; then
    echo "Axiom: 没有服务商「$id」"
    return
  fi

  old_type=$(ini_get "$id" "type"); [ -z "$old_type" ] && old_type="openai"
  old_url=$(ini_get "$id" "api_url")
  old_token=$(ini_get "$id" "token")
  old_models=$(ini_get "$id" "models")

  echo "编辑服务商 [$id]（回车保留原值）"

  printf "协议类型 [%s]: " "$old_type"
  read v
  [ -z "$v" ] && v="$old_type"
  new_type="$v"

  printf "api_url [%s]: " "$old_url"
  read v
  [ -z "$v" ] && v="$old_url"
  new_url="$v"

  printf "token [%s]: " "$old_token"
  read v
  [ -z "$v" ] && v="$old_token"
  new_token="$v"

  printf "models [%s]: " "$old_models"
  read v
  [ -z "$v" ] && v="$old_models"
  new_models="$v"

  ini_delete "$id"
  ini_write "$id" "$new_url" "$new_token" "$new_models" "$new_type"
  echo "Axiom: 已更新服务商「$id」"
}

# ===== 删除服务商 =====
api_rm() {
  id="$1"
  [ -z "$id" ] && { echo "Axiom: 用法：Axiom api rm <ID>"; return; }
  if ! ini_exists "$id"; then
    echo "Axiom: 没有「$id」"
    return
  fi
  ini_delete "$id"
  echo "Axiom: 已删除「$id」"

  if [ -f "$CURRENT" ]; then
    cur=$(sed -n '1p' "$CURRENT")
    if [ "$cur" = "$id" ]; then
      rm -f "$CURRENT"
      echo "Axiom: 当前选中已清空"
    fi
  fi
}

# ===== 列出 / 切换模型 =====
model_mode() {
  if [ $# -eq 0 ]; then
    load_current
    echo "服务商列表："
    for id in $(ini_list_ids); do
      url=$(ini_get "$id" "api_url")
      token=$(ini_get "$id" "token")
      models=$(ini_get "$id" "models")
      type=$(ini_get "$id" "type")
      [ -z "$type" ] && type="openai"
      if [ "$id" = "$CUR_ID" ]; then mark=" *"; else mark=""; fi
      echo "  [$id]$mark  type=$type"
      echo "        url: $url"
      [ -n "$token" ] && echo "        token: $token"
      echo "$models" | tr ',' '\n' | while read m; do
        m=$(printf '%s' "$m" | sed 's/^ *//;s/ *$//')
        [ -z "$m" ] && continue
        if [ "$id" = "$CUR_ID" ] && [ "$m" = "$CUR_MODEL" ]; then
          echo "        - $m  *"
        else
          echo "        - $m"
        fi
      done
    done
    return
  fi

  id="$1"
  model="$2"
  [ -z "$model" ] && { echo "Axiom: 用法：Axiom model <ID> <模型名>"; return; }

  if ! ini_exists "$id"; then
    echo "Axiom: 没有服务商「$id」"
    return
  fi

  models=$(ini_get "$id" "models")
  found=0
  for m in $(echo "$models" | tr ',' ' '); do
    [ "$m" = "$model" ] && found=1 && break
  done

  if [ "$found" -ne 1 ]; then
    echo "Axiom: 服务商「$id」下没有模型「$model」"
    echo "可用：$models"
    return
  fi

  printf '%s\n%s\n' "$id" "$model" > "$CURRENT"
  echo "Axiom: 已切换 → $id / $model"
}

# ===== 入口 =====
case "$1" in
  help)    show_help ;;
  chat)
    shift
    case "$1" in
      api) chat_api ;;
      *)   chat_local ;;
    esac
    ;;
  train)   shift; train_mode "$@" ;;
  brain)   brain_mode ;;
  forget)  shift; forget_mode "$@" ;;
  history) history_mode ;;
  import)  shift; import_mode "$@" ;;
  export)  shift; export_mode "$@" ;;
  api)
    shift
    case "$1" in
      edit) shift; api_edit "$@" ;;
      rm)   shift; api_rm "$@" ;;
      *)    api_add "$@" ;;
    esac
    ;;
  model)   shift; model_mode "$@" ;;
  *)       show_help ;;
esac
