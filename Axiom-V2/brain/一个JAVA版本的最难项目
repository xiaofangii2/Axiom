enum Op {
    NOP, ICONST, ILOAD, ISTORE, IADD, ISUB, IMUL, IDIV, IMOD,
    IFEQ, IFNE, IF_ICMPLT, IF_ICMPLE, IF_ICMPGT, IF_ICMPGE,
