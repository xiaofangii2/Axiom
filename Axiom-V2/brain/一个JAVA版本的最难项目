/* ============================================================
 * TitanJVM.java —— Java 版最难项目（真·完整版）
 * 自举 JVM + Java 编译器 + 运行时 + GC + 类系统 + 函数调用
 * + 异常处理 + 接口继承 + JIT + 多线程调度
 * + 泛型 + Lambda + 反射 + 类加载器
 * + 标准库（集合、IO、网络）
 * + 完整 .class 文件格式（读写）
 * 编译：javac TitanJVM.java
 * 运行：java TitanJVM
 * ============================================================ */

import java.util.*;
import java.io.*;
import java.net.*;

/* ============================================================
 * 第一部分：堆 + 垃圾回收
 * ============================================================ */

class Heap {
    static final int SIZE = 1 << 25;   // 32MB
    static final int CELL = 8;
    byte[] mem = new byte[SIZE];
    boolean[] mark = new boolean[SIZE / CELL];
    int top = 0;

    int alloc(int size) {
        size = (size + CELL - 1) & ~(CELL - 1);
        if (top + size > SIZE) {
            gc();
            if (top + size > SIZE) throw new RuntimeException("OOM");
        }
        int p = top;
        top += size;
        return p;
    }

    void gc() {
        Arrays.fill(mark, false);
        for (int i = 0; i < VM.sp; i++) {
            int v = VM.stack[i];
            if (v > 0 && v < SIZE) mark[v / CELL] = true;
        }
        for (int i = 0; i < VM.localCount; i++) {
            int v = VM.locals[i];
            if (v > 0 && v < SIZE) mark[v / CELL] = true;
        }
        int newTop = 0;
        for (int i = 0; i < mark.length; i++)
            if (mark[i]) newTop = Math.max(newTop, (i + 1) * CELL);
        top = newTop;
    }

    int readInt(int addr) {
        return ((mem[addr] & 0xFF) << 24) | ((mem[addr+1] & 0xFF) << 16) |
               ((mem[addr+2] & 0xFF) << 8) | (mem[addr+3] & 0xFF);
    }

    void writeInt(int addr, int v) {
        mem[addr]   = (byte)(v >> 24);
        mem[addr+1] = (byte)(v >> 16);
        mem[addr+2] = (byte)(v >> 8);
        mem[addr+3] = (byte)v;
    }
}

