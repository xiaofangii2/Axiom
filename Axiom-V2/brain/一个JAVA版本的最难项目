class StdList {
    List<Integer> data = new ArrayList<>();
    void add(int v) { data.add(v); }
    int get(int i) { return data.get(i); }
    int size() { return data.size(); }
    void remove(int i) { data.remove(i); }
}

class StdMap {
    Map<Integer, Integer> data = new HashMap<>();
    void put(int k, int v) { data.put(k, v); }
    int get(int k) { return data.getOrDefault(k, 0); }
    int size() { return data.size(); }
    void remove(int k) { data.remove(k); }
}

class StdSet {
    Set<Integer> data = new HashSet<>();
    void add(int v) { data.add(v); }
    boolean has(int v) { return data.contains(v); }
    int size() { return data.size(); }
}

class StdIO {
    Map<Integer, RandomAccessFile> files = new HashMap<>();
    int nextFd = 1;

    int open(String path, String mode) {
        try {
            RandomAccessFile f = new RandomAccessFile(path, mode);
            files.put(nextFd, f);
            return nextFd++;
        } catch (Exception e) { return -1; }
    }

    int read(int fd, byte[] buf) {
        try {
            RandomAccessFile f = files.get(fd);
            if (f == null) return -1;
            return f.read(buf);
        } catch (Exception e) { return -1; }
    }

    int write(int fd, byte[] buf) {
        try {
            RandomAccessFile f = files.get(fd);
            if (f == null) return -1;
            f.write(buf);
            return buf.length;
        } catch (Exception e) { return -1; }
    }

    void close(int fd) {
        try {
            RandomAccessFile f = files.remove(fd);
            if (f != null) f.close();
        } catch (Exception e) { }
    }
}

class StdNet {
    Map<Integer, Socket> sockets = new HashMap<>();
    int nextFd = 1;

    int connect(String host, int port) {
        try {
            Socket s = new Socket(host, port);
            sockets.put(nextFd, s);
            return nextFd++;
        } catch (Exception e) { return -1; }
    }

    int send(int fd, byte[] buf) {
        try {
            Socket s = sockets.get(fd);
            if (s == null) return -1;
            s.getOutputStream().write(buf);
            return buf.length;
        } catch (Exception e) { return -1; }
    }

    int recv(int fd, byte[] buf) {
        try {
            Socket s = sockets.get(fd);
            if (s == null) return -1;
            return s.getInputStream().read(buf);
        } catch (Exception e) { return -1; }
    }

    void close(int fd) {
        try {
            Socket s = sockets.remove(fd);
            if (s != null) s.close();
        } catch (Exception e) { }
    }
}

