class Compiler {
    List<Token> tokens;
    int pos;
    List<Instr> code = new ArrayList<>();
    Map<String, Integer> vars = new HashMap<>();
    Map<String, Klass> classes = new HashMap<>();
    Map<String, Integer> funcs = new HashMap<>();
    Map<String, Lambda> lambdas = new HashMap<>();
    int varCount = 0;
    int labelCount = 0;
    int lambdaCount = 0;

    Compiler(List<Token> tokens) { this.tokens = tokens; }

    Token peek() { return tokens.get(pos); }
    Token next()  { return tokens.get(pos++); }
    boolean check(Tok k) { return peek().kind == k; }
    Token expect(Tok k) {
        if (!check(k)) throw new RuntimeException("expected " + k + " got " + peek().kind);
        return next();
    }

    int newLabel() { return labelCount++; }
    void emit(Op op) { code.add(new Instr(op)); }
    void emit(Op op, int operand) { code.add(new Instr(op, operand)); }
    void emit(Op op, String s) { code.add(new Instr(op, s)); }

    int varIndex(String name) {
        if (!vars.containsKey(name)) vars.put(name, varCount++);
        return vars.get(name);
    }

    void compile() {
        while (!check(Tok.EOF)) {
            if (check(Tok.CLASS)) classDecl();
            else if (check(Tok.INTERFACE)) interfaceDecl();
            else if (check(Tok.THREAD)) threadDecl();
            else if (check(Tok.GENERIC)) genericDecl();
            else if (check(Tok.REFLECT)) reflectDecl();
            else if (check(Tok.LOADER)) loaderDecl();
            else if (check(Tok.CLASSDEF)) classdefDecl();
            else if (check(Tok.INT) && pos + 1 < tokens.size() &&
                     tokens.get(pos+1).kind == Tok.IDENT &&
                     pos + 2 < tokens.size() && tokens.get(pos+2).kind == Tok.LPAREN)
                funcDecl();
            else if (check(Tok.VOID)) funcDecl();
            else stmt();
        }
        emit(Op.HALT);
    }

    void classdefDecl() {
        expect(Tok.CLASSDEF);
        String name = expect(Tok.IDENT).name;
        expect(Tok.LBRACE);
        while (!check(Tok.RBRACE) && !check(Tok.EOF)) {
            if (check(Tok.FIELD)) {
                next();
                String f = expect(Tok.IDENT).name;
                emit(Op.CLASSDEF_FIELD, name + "|" + f);
                expect(Tok.SEMI);
            } else if (check(Tok.METHOD)) {
                next();
                String m = expect(Tok.IDENT).name;
                emit(Op.CLASSDEF_METHOD, name + "|" + m);
                expect(Tok.SEMI);
            } else stmt();
        }
        expect(Tok.RBRACE);
        emit(Op.CLASSDEF_NEW, name);
    }

    void genericDecl() {
        expect(Tok.GENERIC);
        String name = expect(Tok.IDENT).name;
        expect(Tok.LT);
        List<String> params = new ArrayList<>();
        params.add(expect(Tok.IDENT).name);
        while (check(Tok.COMMA)) { next(); params.add(expect(Tok.IDENT).name); }
        expect(Tok.GT);
        Klass k = new Klass(name);
        k.typeParams.addAll(params);
        classes.put(name, k);
        expect(Tok.LBRACE);
        while (!check(Tok.RBRACE) && !check(Tok.EOF)) {
            if (check(Tok.INT)) {
                next(); String f = expect(Tok.IDENT).name; k.addField(f); expect(Tok.SEMI);
            } else if (check(Tok.VOID)) {
                next(); String m = expect(Tok.IDENT).name;
                expect(Tok.LPAREN); expect(Tok.RPAREN);
                int addr = code.size();
                k.addMethod(m, addr, 0);
                expect(Tok.LBRACE);
                while (!check(Tok.RBRACE) && !check(Tok.EOF)) stmt();
                expect(Tok.RBRACE);
                emit(Op.RETURN);
            } else throw new RuntimeException("unexpected in generic: " + peek().kind);
        }
        expect(Tok.RBRACE);
    }

    void reflectDecl() {
        expect(Tok.REFLECT);
        expect(Tok.LBRACE);
        while (!check(Tok.RBRACE) && !check(Tok.EOF)) stmt();
        expect(Tok.RBRACE);
    }

    void loaderDecl() {
        expect(Tok.LOADER);
        expect(Tok.LBRACE);
        while (!check(Tok.RBRACE) && !check(Tok.EOF)) stmt();
        expect(Tok.RBRACE);
    }

    void interfaceDecl() {
        expect(Tok.INTERFACE);
        String name = expect(Tok.IDENT).name;
        Klass k = new Klass(name);
        classes.put(name, k);
        expect(Tok.LBRACE);
        while (!check(Tok.RBRACE) && !check(Tok.EOF)) {
            if (check(Tok.INT)) next(); else expect(Tok.VOID);
            String mName = expect(Tok.IDENT).name;
            expect(Tok.LPAREN);
            while (!check(Tok.RPAREN)) next();
            expect(Tok.RPAREN);
            expect(Tok.SEMI);
            k.addMethod(mName, -1, 0);
        }
        expect(Tok.RBRACE);
    }

    void threadDecl() {
        expect(Tok.THREAD);
        String name = expect(Tok.IDENT).name;
        Klass k = new Klass(name);
        classes.put(name, k);
        expect(Tok.LBRACE);
        while (!check(Tok.RBRACE) && !check(Tok.EOF)) {
            if (check(Tok.INT)) {
                next(); expect(Tok.IDENT); k.size += 4; expect(Tok.SEMI);
            } else if (check(Tok.VOID)) {
                next();
                String mName = expect(Tok.IDENT).name;
                expect(Tok.LPAREN);
                int params = 0;
                if (!check(Tok.RPAREN)) {
                    expect(Tok.INT); expect(Tok.IDENT); params++;
                    while (check(Tok.COMMA)) { next(); expect(Tok.INT); expect(Tok.IDENT); params++; }
                }
                expect(Tok.RPAREN);
                int addr = code.size();
                k.addMethod(mName, addr, params);
                expect(Tok.LBRACE);
                while (!check(Tok.RBRACE) && !check(Tok.EOF)) stmt();
                expect(Tok.RBRACE);
                emit(Op.RETURN);
            } else throw new RuntimeException("unexpected in thread: " + peek().kind);
        }
        expect(Tok.RBRACE);
    }

    void funcDecl() {
        if (check(Tok.INT)) next(); else expect(Tok.VOID);
        String name = expect(Tok.IDENT).name;
        expect(Tok.LPAREN);
        List<String> params = new ArrayList<>();
        if (!check(Tok.RPAREN)) {
            expect(Tok.INT);
            params.add(expect(Tok.IDENT).name);
            while (check(Tok.COMMA)) {
                next(); expect(Tok.INT); params.add(expect(Tok.IDENT).name);
            }
        }
        expect(Tok.RPAREN);
        int addr = code.size();
        funcs.put(name, addr);

        Map<String, Integer> savedVars = new HashMap<>(vars);
        int savedCount = varCount;
        vars.clear(); varCount = 0;
        for (String p : params) varIndex(p);

        expect(Tok.LBRACE);
        while (!check(Tok.RBRACE) && !check(Tok.EOF)) stmt();
        expect(Tok.RBRACE);
        emit(Op.RETURN);

        vars = savedVars; varCount = savedCount;
    }

    void classDecl() {
        expect(Tok.CLASS);
        String name = expect(Tok.IDENT).name;
        Klass k = new Klass(name);
        classes.put(name, k);
        if (check(Tok.EXTENDS)) {
            next();
            String parent = expect(Tok.IDENT).name;
            Klass p = classes.get(parent);
            if (p != null) k.inherit(p);
        }
        if (check(Tok.IMPLEMENTS)) {
            next();
            while (!check(Tok.LBRACE)) {
                String iface = expect(Tok.IDENT).name;
                k.interfaces.add(iface);
                if (!check(Tok.COMMA)) break;
                next();
            }
        }
        expect(Tok.LBRACE);
        while (!check(Tok.RBRACE) && !check(Tok.EOF)) {
            if (check(Tok.INT)) {
                next(); String f = expect(Tok.IDENT).name; k.addField(f); expect(Tok.SEMI);
            } else if (check(Tok.VOID)) {
                next();
                String mName = expect(Tok.IDENT).name;
                expect(Tok.LPAREN);
                int params = 0;
                if (!check(Tok.RPAREN)) {
                    expect(Tok.INT); expect(Tok.IDENT); params++;
                    while (check(Tok.COMMA)) { next(); expect(Tok.INT); expect(Tok.IDENT); params++; }
                }
                expect(Tok.RPAREN);
                int addr = code.size();
                k.addMethod(mName, addr, params);
                expect(Tok.LBRACE);
                while (!check(Tok.RBRACE) && !check(Tok.EOF)) stmt();
                expect(Tok.RBRACE);
                emit(Op.RETURN);
            } else throw new RuntimeException("unexpected in class: " + peek().kind);
        }
        expect(Tok.RBRACE);
    }

    void stmt() {
        if (check(Tok.INT)) {
            next();
            String name = expect(Tok.IDENT).name;
            int idx = varIndex(name);
            if (check(Tok.EQ)) { next(); expr(); emit(Op.ISTORE, idx); }
            expect(Tok.SEMI);
            return;
        }

        if (check(Tok.PRINT)) {
            next();
            if (check(Tok.STR)) emit(Op.PRINTSTR, next().name);
            else { expr(); emit(Op.PRINT); }
            expect(Tok.SEMI);
            return;
        }

        if (check(Tok.RETURN)) {
            next();
            if (!check(Tok.SEMI)) expr();
            expect(Tok.SEMI);
            emit(Op.IRETURN);
            return;
        }

        if (check(Tok.IF)) {
            next(); expect(Tok.LPAREN); expr(); expect(Tok.RPAREN);
            int l1 = newLabel(), l2 = newLabel();
            emit(Op.IFEQ, l1);
            stmt();
            emit(Op.GOTO, l2);
            code.add(new Instr(Op.NOP, l1));
            if (check(Tok.ELSE)) { next(); stmt(); }
            code.add(new Instr(Op.NOP, l2));
            return;
        }

        if (check(Tok.WHILE)) {
            next();
            int l1 = newLabel(), l2 = newLabel();
            code.add(new Instr(Op.NOP, l1));
            expect(Tok.LPAREN); expr(); expect(Tok.RPAREN);
            emit(Op.IFEQ, l2);
            stmt();
            emit(Op.GOTO, l1);
            code.add(new Instr(Op.NOP, l2));
            return;
        }

        if (check(Tok.TRY)) { tryStmt(); return; }
        if (check(Tok.THROW)) { next(); expr(); expect(Tok.SEMI); emit(Op.THROW); return; }

        if (check(Tok.LBRACE)) {
            next();
            while (!check(Tok.RBRACE) && !check(Tok.EOF)) stmt();
            expect(Tok.RBRACE);
            return;
        }

        if (check(Tok.SEMI)) { next(); return; }

        if (check(Tok.LIST)) { listStmt(); return; }
        if (check(Tok.MAP)) { mapStmt(); return; }
        if (check(Tok.SET)) { setStmt(); return; }
        if (check(Tok.IO)) { ioStmt(); return; }
        if (check(Tok.NET)) { netStmt(); return; }

        if (check(Tok.IDENT) && pos + 1 < tokens.size()) {
            Token id = peek();
            Tok nk = tokens.get(pos + 1).kind;
            if (nk == Tok.EQ) {
                next(); next(); expr();
                emit(Op.ISTORE, varIndex(id.name));
                expect(Tok.SEMI);
                return;
            }
            if (nk == Tok.LPAREN) { callFunc(); expect(Tok.SEMI); return; }
        }

        expr();
        expect(Tok.SEMI);
    }

    void listStmt() {
        expect(Tok.LIST);
        String name = expect(Tok.IDENT).name;
        int idx = varIndex(name);
        emit(Op.LIST_NEW);
        emit(Op.ISTORE, idx);
        expect(Tok.SEMI);
        while (check(Tok.DOT)) {
            next();
            String op = expect(Tok.IDENT).name;
            expect(Tok.LPAREN);
            if (op.equals("add")) {
                expr(); emit(Op.ILOAD, idx); emit(Op.LIST_ADD);
            } else if (op.equals("get")) {
                expr(); emit(Op.ILOAD, idx); emit(Op.LIST_GET);
            } else if (op.equals("size")) {
                emit(Op.ILOAD, idx); emit(Op.LIST_SIZE);
            } else if (op.equals("remove")) {
                expr(); emit(Op.ILOAD, idx); emit(Op.LIST_REMOVE);
            }
            expect(Tok.RPAREN);
            expect(Tok.SEMI);
        }
    }

    void mapStmt() {
        expect(Tok.MAP);
        String name = expect(Tok.IDENT).name;
        int idx = varIndex(name);
        emit(Op.MAP_NEW);
        emit(Op.ISTORE, idx);
        expect(Tok.SEMI);
        while (check(Tok.DOT)) {
            next();
            String op = expect(Tok.IDENT).name;
            expect(Tok.LPAREN);
            if (op.equals("put")) {
                expr(); expect(Tok.COMMA); expr();
                emit(Op.ILOAD, idx); emit(Op.MAP_PUT);
            } else if (op.equals("get")) {
                expr(); emit(Op.ILOAD, idx); emit(Op.MAP_GET);
            } else if (op.equals("size")) {
                emit(Op.ILOAD, idx); emit(Op.MAP_SIZE);
            } else if (op.equals("remove")) {
                expr(); emit(Op.ILOAD, idx); emit(Op.MAP_REMOVE);
            }
            expect(Tok.RPAREN);
            expect(Tok.SEMI);
        }
    }

    void setStmt() {
        expect(Tok.SET);
        String name = expect(Tok.IDENT).name;
        int idx = varIndex(name);
        emit(Op.SET_NEW);
        emit(Op.ISTORE, idx);
        expect(Tok.SEMI);
        while (check(Tok.DOT)) {
            next();
            String op = expect(Tok.IDENT).name;
            expect(Tok.LPAREN);
            if (op.equals("add")) {
                expr(); emit(Op.ILOAD, idx); emit(Op.SET_ADD);
            } else if (op.equals("has")) {
                expr(); emit(Op.ILOAD, idx); emit(Op.SET_HAS);
            } else if (op.equals("size")) {
                emit(Op.ILOAD, idx); emit(Op.SET_SIZE);
            }
            expect(Tok.RPAREN);
            expect(Tok.SEMI);
        }
    }

    void ioStmt() {
        expect(Tok.IO);
        String name = expect(Tok.IDENT).name;
        int idx = varIndex(name);
        emit(Op.ICONST, 0);
        emit(Op.ISTORE, idx);
        expect(Tok.SEMI);
        while (check(Tok.DOT)) {
            next();
            String op = expect(Tok.IDENT).name;
            expect(Tok.LPAREN);
            if (op.equals("open")) {
                expect(Tok.STR); String path = tokens.get(pos - 1).name;
                expect(Tok.COMMA);
                expect(Tok.STR); String mode = tokens.get(pos - 1).name;
                emit(Op.IO_OPEN, path + "|" + mode);
                emit(Op.ISTORE, idx);
            } else if (op.equals("read")) {
                emit(Op.ILOAD, idx); emit(Op.IO_READ);
            } else if (op.equals("write")) {
                emit(Op.ILOAD, idx); emit(Op.IO_WRITE);
            } else if (op.equals("close")) {
                emit(Op.ILOAD, idx); emit(Op.IO_CLOSE);
            }
            expect(Tok.RPAREN);
            expect(Tok.SEMI);
        }
    }

    void netStmt() {
        expect(Tok.NET);
        String name = expect(Tok.IDENT).name;
        int idx = varIndex(name);
        emit(Op.ICONST, 0);
        emit(Op.ISTORE, idx);
        expect(Tok.SEMI);
        while (check(Tok.DOT)) {
            next();
            String op = expect(Tok.IDENT).name;
            expect(Tok.LPAREN);
            if (op.equals("connect")) {
                expect(Tok.STR); String host = tokens.get(pos - 1).name;
                expect(Tok.COMMA);
                int port = expect(Tok.NUM).val;
                emit(Op.NET_CONNECT, host + "|" + port);
                emit(Op.ISTORE, idx);
            } else if (op.equals("send")) {
                emit(Op.ILOAD, idx); emit(Op.NET_SEND);
            } else if (op.equals("recv")) {
                emit(Op.ILOAD, idx); emit(Op.NET_RECV);
            } else if (op.equals("close")) {
                emit(Op.ILOAD, idx); emit(Op.NET_CLOSE);
            }
            expect(Tok.RPAREN);
            expect(Tok.SEMI);
        }
    }

    void tryStmt() {
        expect(Tok.TRY);
        expect(Tok.LBRACE);
        int tryStart = code.size();
        while (!check(Tok.RBRACE) && !check(Tok.EOF)) stmt();
        expect(Tok.RBRACE);
        int tryEnd = code.size();
        emit(Op.TRY_END);

        expect(Tok.CATCH);
        expect(Tok.LPAREN);
        expect(Tok.INT); expect(Tok.IDENT);
        expect(Tok.RPAREN);
        int catchAddr = code.size();
        expect(Tok.LBRACE);
        while (!check(Tok.RBRACE) && !check(Tok.EOF)) stmt();
        expect(Tok.RBRACE);

        code.add(tryStart, new Instr(Op.TRY_BEGIN, catchAddr));
        code.add(tryEnd, new Instr(Op.TRY_END));
        emit(Op.NOP, catchAddr);
    }

    void callFunc() {
        String name = expect(Tok.IDENT).name;
        expect(Tok.LPAREN);
        int argc = 0;
        if (!check(Tok.RPAREN)) {
            expr(); argc++;
            while (check(Tok.COMMA)) { next(); expr(); argc++; }
        }
        expect(Tok.RPAREN);
        Integer addr = funcs.get(name);
        if (addr != null) { emit(Op.INVOKE, addr); return; }
        for (Klass k : classes.values()) {
            Method m = k.findMethod(name);
            if (m != null) { emit(Op.INVOKEVIRTUAL, m.addr); return; }
        }
        throw new RuntimeException("undefined function: " + name);
    }

    void expr() { rel(); }

    void rel() {
        add();
        while (true) {
            Tok k = peek().kind;
            if (k != Tok.EQEQ && k != Tok.NE && k != Tok.LT &&
                k != Tok.LE && k != Tok.GT && k != Tok.GE) return;
            next(); add();
            switch (k) {
                case EQEQ: emit(Op.IF_ICMPLT, -1); break;
                case NE:   emit(Op.IF_ICMPLT, -2); break;
                case LT:   emit(Op.IF_ICMPLT, 0);  break;
                case LE:   emit(Op.IF_ICMPLE, 0);  break;
                case GT:   emit(Op.IF_ICMPGT, 0);  break;
                case GE:   emit(Op.IF_ICMPGE, 0);  break;
            }
        }
    }

    void add() {
        mul();
        while (true) {
            if (check(Tok.PLUS))  { next(); mul(); emit(Op.IADD); }
            else if (check(Tok.MINUS)) { next(); mul(); emit(Op.ISUB); }
            else return;
        }
    }

    void mul() {
        primary();
        while (true) {
            if (check(Tok.STAR))  { next(); primary(); emit(Op.IMUL); }
            else if (check(Tok.SLASH)) { next(); primary(); emit(Op.IDIV); }
            else if (check(Tok.PERCENT)) { next(); primary(); emit(Op.IMOD); }
            else return;
        }
    }

    void primary() {
        if (check(Tok.NUM)) { emit(Op.ICONST, next().val); return; }
        if (check(Tok.LPAREN)) { next(); expr(); expect(Tok.RPAREN); return; }
        if (check(Tok.NEW)) {
            next();
            if (check(Tok.INT)) {
                next(); expect(Tok.LBRACKET); expr(); expect(Tok.RBRACKET);
                emit(Op.NEWARRAY);
                return;
            }
            String cn = expect(Tok.IDENT).name;
            Klass k = classes.get(cn);
            if (k == null) throw new RuntimeException("unknown class: " + cn);
            emit(Op.NEW, k.size);
            return;
        }
        if (check(Tok.IDENT)) {
            String name = next().name;
            if (check(Tok.LPAREN)) { pos--; callFunc(); return; }
            emit(Op.ILOAD, varIndex(name));
            return;
        }
        throw new RuntimeException("unexpected token in primary: " + peek().kind);
    }
}

/* ============================================================
 * 第十部分：JIT 编译器
 * ============================================================ */

class JIT {
    static boolean isCompilable(Instr i) {
        switch (i.op) {
            case ICONST: case ILOAD: case ISTORE: case IADD: case ISUB:
            case IMUL: case IDIV: case GOTO: case IFEQ: case IFNE:
            case IF_ICMPLT: case IF_ICMPLE: case IF_ICMPGT: case IF_ICMPGE:
            case RETURN: case IRETURN: case HALT:
                return true;
            default: return false;
        }
    }

    static int[] compile(List<Instr> code) {
        List<Integer> out = new ArrayList<>();
        for (Instr i : code) {
            if (i.op == Op.NOP) continue;
            if (isCompilable(i)) {
                out.add(i.op.ordinal());
                out.add(i.operand);
            }
        }
        int[] arr = new int[out.size()];
        for (int i = 0; i < out.size(); i++) arr[i] = out.get(i);
        return arr;
    }
}

/* ============================================================
 * 第十一部分：虚拟机 + 线程调度 + 标准库 + .class 加载
 * ============================================================ */

class ThreadCtx {
    int pc;
    int sp;
    int[] locals;
    boolean running = true;

    ThreadCtx(int pc, int sp, int[] locals) {
        this.pc = pc; this.sp = sp; this.locals = locals;
    }
}

class VM {
    static Heap heap = new Heap();
    static int[] stack = new int[131072];
    static int[] locals = new int[32768];
    static int sp = 0;
    static int localCount = 0;
    static List<ThreadCtx> threads = new ArrayList<>();
    static Object monitor = new Object();
    static Map<Integer, Integer> tryTable = new HashMap<>();
    static ClassLoader loader = new ClassLoader(null);
    static Reflect reflect = new Reflect();
    static StdList[] lists = new StdList[1024];
    static StdMap[] maps = new StdMap[1024];
    static StdSet[] sets = new StdSet[1024];
    static StdIO io = new StdIO();
    static StdNet net = new StdNet();
    static int listCount = 0, mapCount = 0, setCount = 0;
    static Map<String, ClassFile> classFiles = new HashMap<>();

    List<Instr> code;
    int pc = 0;
    boolean running = true;

    VM(List<Instr> code) { this.code = code; }

    void push(int v) { stack[sp++] = v; }
    int pop() { return stack[--sp]; }

    int run() {
        while (running && pc < code.size()) {
            Instr ins = code.get(pc++);
            switch (ins.op) {
                case NOP: break;
                case ICONST: push(ins.operand); break;
                case ILOAD:  push(locals[ins.operand]); localCount = Math.max(localCount, ins.operand+1); break;
                case ISTORE: locals[ins.operand] = pop(); localCount = Math.max(localCount, ins.operand+1); break;
                case IADD: { int b = pop(), a = pop(); push(a + b); break; }
                case ISUB: { int b = pop(), a = pop(); push(a - b); break; }
                case IMUL: { int b = pop(), a = pop(); push(a * b); break; }
                case IDIV: { int b = pop(), a = pop(); push(a / b); break; }
                case IMOD: { int b = pop(), a = pop(); push(a % b); break; }
                case IFEQ: if (pop() == 0) pc = ins.operand; break;
                case IFNE: if (pop() != 0) pc = ins.operand; break;
                case IF_ICMPLT: { int b = pop(), a = pop(); if (a < b) pc = ins.operand; break; }
                case IF_ICMPLE: { int b = pop(), a = pop(); if (a <= b) pc = ins.operand; break; }
                case IF_ICMPGT: { int b = pop(), a = pop(); if (a > b) pc = ins.operand; break; }
                case IF_ICMPGE: { int b = pop(), a = pop(); if (a >= b) pc = ins.operand; break; }
                case GOTO: pc = ins.operand; break;
                case PRINT: System.out.println(pop()); break;
                case PRINTSTR: System.out.println(ins.str); break;
                case NEW: {
                    int addr = heap.alloc(ins.operand);
                    for (int i = 0; i < ins.operand; i += 4) heap.writeInt(addr + i, 0);
                    push(addr);
                    break;
                }
                case NEWARRAY: {
                    int size = pop();
                    int addr = heap.alloc(size * 4 + 4);
                    heap.writeInt(addr, size);
                    push(addr + 4);
                    break;
                }
                case IALOAD: { int idx = pop(), base = pop(); push(heap.readInt(base + idx * 4)); break; }
                case IASTORE: { int val = pop(), idx = pop(), base = pop(); heap.writeInt(base + idx * 4, val); break; }
                case ARRAYLENGTH: { int base = pop(); push(heap.readInt(base - 4)); break; }
                case DUP: { int v = pop(); push(v); push(v); break; }
                case POP: pop(); break;
                case INVOKE: { int retPc = pc; pc = ins.operand; push(retPc); break; }
                case INVOKEVIRTUAL: { int retPc = pc; pc = ins.operand; push(retPc); break; }
                case RETURN: { int retPc = pop(); pc = retPc; break; }
                case IRETURN: return pop();

                case TRY_BEGIN: tryTable.put(pc - 1, ins.operand); break;
                case TRY_END: tryTable.remove(pc - 2); break;
                case THROW: {
                    int exc = pop();
                    if (!tryTable.isEmpty()) pc = tryTable.values().iterator().next();
                    else throw new RuntimeException("uncaught exception: " + exc);
                    break;
                }
                case CATCH: break;

                case THREAD_START: {
                    int startPc = pop();
                    threads.add(new ThreadCtx(startPc, sp, locals.clone()));
                    break;
                }
                case THREAD_JOIN: {
                    if (!threads.isEmpty()) threads.remove(0);
                    break;
                }
                case MONITOR_ENTER: synchronized (monitor) { break; }
                case MONITOR_EXIT: synchronized (monitor) { break; }

                case JIT_COMPILE: {
                    int[] nativeCode = JIT.compile(code);
                    push(nativeCode.length);
                    break;
                }

                case LAMBDA: push(ins.operand); break;
                case INVOKEDYNAMIC: { int retPc = pc; pc = ins.operand; push(retPc); break; }
                case GENERIC_NEW: {
                    int addr = heap.alloc(ins.operand);
                    for (int i = 0; i < ins.operand; i += 4) heap.writeInt(addr + i, 0);
                    push(addr);
                    break;
                }
                case REFLECT_GET: { int obj = pop(); push(obj); break; }
                case REFLECT_SET: { int val = pop(); int obj = pop(); push(val); break; }
                case LOAD_CLASS: {
                    Klass k = loader.loadClass(ins.str);
                    push(k != null ? k.hashCode() : 0);
                    break;
                }
                case DEFINE_CLASS: {
                    Klass k = new Klass(ins.str);
                    loader.defineClass(ins.str, k);
                    push(k.hashCode());
                    break;
                }

                case LIST_NEW: {
                    lists[listCount] = new StdList();
                    push(listCount++);
                    break;
                }
                case LIST_ADD: { int idx = pop(); int val = pop(); lists[idx].add(val); break; }
                case LIST_GET: { int idx = pop(); int i = pop(); push(lists[idx].get(i)); break; }
                case LIST_SIZE: { int idx = pop(); push(lists[idx].size()); break; }
                case LIST_REMOVE: { int idx = pop(); int i = pop(); lists[idx].remove(i); break; }

                case MAP_NEW: { maps[mapCount] = new StdMap(); push(mapCount++); break; }
                case MAP_PUT: { int idx = pop(); int v = pop(); int k = pop(); maps[idx].put(k, v); break; }
                case MAP_GET: { int idx = pop(); int k = pop(); push(maps[idx].get(k)); break; }
                case MAP_SIZE: { int idx = pop(); push(maps[idx].size()); break; }
                case MAP_REMOVE: { int idx = pop(); int k = pop(); maps[idx].remove(k); break; }

                case SET_NEW: { sets[setCount] = new StdSet(); push(setCount++); break; }
                case SET_ADD: { int idx = pop(); int v = pop(); sets[idx].add(v); break; }
                case SET_HAS: { int idx = pop(); int v = pop(); push(sets[idx].has(v) ? 1 : 0); break; }
                case SET_SIZE: { int idx = pop(); push(sets[idx].size()); break; }

                case IO_OPEN: {
                    String[] parts = ins.str.split("\\|");
                    push(io.open(parts[0], parts[1]));
                    break;
                }
                case IO_READ: { int fd = pop(); byte[] buf = new byte[1024]; push(io.read(fd, buf)); break; }
                case IO_WRITE: { int fd = pop(); byte[] buf = new byte[1024]; push(io.write(fd, buf)); break; }
                case IO_CLOSE: { int fd = pop(); io.close(fd); break; }

                case NET_CONNECT: {
                    String[] parts = ins.str.split("\\|");
                    push(net.connect(parts[0], Integer.parseInt(parts[1])));
                    break;
                }
                case NET_SEND: { int fd = pop(); byte[] buf = new byte[1024]; push(net.send(fd, buf)); break; }
                case NET_RECV: { int fd = pop(); byte[] buf = new byte[1024]; push(net.recv(fd, buf)); break; }
                case NET_CLOSE: { int fd = pop(); net.close(fd); break; }

                case CLASSDEF_NEW: {
                    Klass k = new Klass(ins.str);
                    classes.put(ins.str, k);
                    push(k.hashCode());
                    break;
                }
                case CLASSDEF_FIELD: {
                    String[] parts = ins.str.split("\\|");
                    Klass k = classes.get(parts[0]);
                    if (k != null) k.addField(parts[1]);
                    break;
                }
                case CLASSDEF_METHOD: {
                    String[] parts = ins.str.split("\\|");
                    Klass k = classes.get(parts[0]);
                    if (k != null) k.addMethod(parts[1], 0, 0);
                    break;
                }
                case CLASSDEF_WRITE: {
                    try {
                        ClassFile cf = new ClassFile();
                        String cn = ins.str;
                        Klass k = classes.get(cn);
                        byte[] data = cf.write(cn, k);
                        classFiles.put(cn, ClassFile.read(data));
                        push(data.length);
                    } catch (Exception e) {
                        push(-1);
                    }
                    break;
                }
                case CLASSDEF_READ: {
                    try {
                        ClassFile cf = ClassFile.read(classFiles.get(ins.str).write(ins.str, classes.get(ins.str)));
                        push(cf.methods.size());
                    } catch (Exception e) {
                        push(-1);
                    }
                    break;
                }
                case CLASSDEF_LOAD: {
                    Klass k = loader.loadClass(ins.str);
                    push(k != null ? k.hashCode() : 0);
                    break;
                }

                case HALT: running = false; return 0;
                default: throw new RuntimeException("unknown op: " + ins.op);
            }
        }
        return 0;
    }

    void schedule() {
        while (!threads.isEmpty()) {
            ThreadCtx t = threads.remove(0);
            if (!t.running) continue;
            int oldPc = pc, oldSp = sp;
            int[] oldLocals = locals;
            pc = t.pc; sp = t.sp; locals = t.locals;
            try { run(); } catch (Exception e) { System.out.println("thread error: " + e.getMessage()); }
            t.pc = pc; t.sp = sp; t.locals = locals;
            pc = oldPc; sp = oldSp; locals = oldLocals;
            if (t.pc < code.size()) threads.add(t);
        }
    }
}

/* ============================================================
 * 第十二部分：入口
 * ============================================================ */

public class TitanJVM {
    public static void main(String[] args) throws Exception {
        String source =
            "int add(int a, int b) { return a + b; }" +
            "int fact(int n) {" +
            "  if (n <= 1) { return 1; }" +
            "  return n * fact(n - 1);" +
            "}" +
            "class Counter {" +
            "  int value;" +
            "  void inc() { value = value + 1; }" +
            "}" +
            "interface Greeter { void greet(); }" +
            "generic Box<T> {" +
            "  int item;" +
            "  void set() { item = 42; }" +
            "}" +
            "classdef MyClass {" +
            "  field x;" +
            "  method foo;" +
            "}" +
            "int i = 0;" +
            "int sum = 0;" +
            "while (i < 10) {" +
            "  sum = add(sum, i);" +
            "  i = i + 1;" +
            "}" +
            "print sum;" +
            "int f = fact(5);" +
            "print f;" +
            "int[] arr = new int[10];" +
            "int j = 0;" +
            "while (j < 10) {" +
            "  arr[j] = j * j;" +
            "  j = j + 1;" +
            "}" +
            "print arr[9];" +
            "try { throw 42; } catch (int e) { print e; }" +
            "list L;" +
            "L.add(10);" +
            "L.add(20);" +
            "print L.get(0);" +
            "print L.size();" +
            "map M;" +
            "M.put(1, 100);" +
            "print M.get(1);" +
            "set S;" +
            "S.add(5);" +
            "print S.has(5);" +
            "print \"done\";" +
            "return sum;";

        System.out.println("=== 编译源码 ===");
        List<Token> tokens = new Lexer(source).tokenize();
        Compiler compiler = new Compiler(tokens);
        compiler.compile();

        System.out.println("=== 字节码 (" + compiler.code.size() + " 条) ===");
        for (int i = 0; i < compiler.code.size(); i++) {
            Instr ins = compiler.code.get(i);
            System.out.println(i + ": " + ins.op + " " + ins.operand +
                (ins.str != null ? " \"" + ins.str + "\"" : ""));
        }

        System.out.println("=== JIT 编译 ===");
        int[] nativeCode = JIT.compile(compiler.code);
        System.out.println("原生指令数: " + (nativeCode.length / 2));

        System.out.println("=== .class 文件读写 ===");
        ClassFile cf = new ClassFile();
        Klass testKlass = new Klass("TestClass");
        testKlass.addField("x");
        testKlass.addField("y");
        testKlass.addMethod("foo", 0, 0);
        testKlass.addMethod("bar", 10, 1);
        byte[] classData = cf.write("TestClass", testKlass);
        System.out.println("写入 .class 文件: " + classData.length + " 字节");
        ClassFile readBack = ClassFile.read(classData);
        System.out.println("读回 .class 文件: 字段 " + readBack.fields.size() +
            " 个, 方法 " + readBack.methods.size() + " 个");
        System.out.println("魔数: 0x" + Integer.toHexString(ClassFile.MAGIC));

        System.out.println("=== 运行 ===");
        VM vm = new VM(compiler.code);
        int result = vm.run();
        System.out.println("返回值: " + result);
    }
}
