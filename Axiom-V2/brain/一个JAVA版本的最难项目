class Lambda {
    String name;
    int addr;
    int paramCount;
    List<String> captured = new ArrayList<>();

    Lambda(String name, int addr, int paramCount) {
        this.name = name; this.addr = addr; this.paramCount = paramCount;
    }
}

class Reflect {
    Map<String, Klass> classes = new HashMap<>();

    Klass forName(String name) { return classes.get(name); }

    Object getField(Object obj, String field) {
        if (obj instanceof Map) return ((Map<?, ?>) obj).get(field);
        return null;
    }

    void setField(Object obj, String field, Object val) {
        if (obj instanceof Map) ((Map<String, Object>) obj).put(field, val);
    }

    Object invoke(Object obj, String method, Object... args) {
        return "invoked:" + method;
    }
}

/* ============================================================
 * 第六部分：类加载器
 * ============================================================ */

class ClassLoader {
    Map<String, Klass> loaded = new HashMap<>();
    ClassLoader parent;

    ClassLoader(ClassLoader parent) { this.parent = parent; }

    Klass loadClass(String name) {
        if (loaded.containsKey(name)) return loaded.get(name);
        if (parent != null) {
            Klass k = parent.loadClass(name);
            if (k != null) return k;
        }
        Klass k = new Klass(name);
        loaded.put(name, k);
        return k;
    }

    void defineClass(String name, Klass k) {
        loaded.put(name, k);
    }
}

/* ============================================================
 * 第七部分：.class 文件格式（读写）
 * ============================================================ */

class ClassFile {
    static final int MAGIC = 0xCAFEBABE;
    static final int MINOR = 0;
    static final int MAJOR = 52; // Java 8

    /* 常量池 */
    static class ConstantPool {
        List<Object> entries = new ArrayList<>();
        Map<String, Integer> utf8Index = new HashMap<>();

        int addUtf8(String s) {
            if (utf8Index.containsKey(s)) return utf8Index.get(s);
            entries.add(s);
            int idx = entries.size();
            utf8Index.put(s, idx);
            return idx;
        }

        int addInteger(int v) {
            entries.add(v);
            return entries.size();
        }

        int addClass(String name) {
            int nameIdx = addUtf8(name);
            entries.add(new int[]{7, nameIdx}); // CONSTANT_Class
            return entries.size();
        }

        int addNameAndType(String name, String desc) {
            int n = addUtf8(name);
            int d = addUtf8(desc);
            entries.add(new int[]{12, n, d}); // CONSTANT_NameAndType
            return entries.size();
        }

        int addFieldref(String cls, String name, String desc) {
            int c = addClass(cls);
            int nt = addNameAndType(name, desc);
            entries.add(new int[]{9, c, nt}); // CONSTANT_Fieldref
            return entries.size();
        }

        int addMethodref(String cls, String name, String desc) {
            int c = addClass(cls);
            int nt = addNameAndType(name, desc);
            entries.add(new int[]{10, c, nt}); // CONSTANT_Methodref
            return entries.size();
        }
    }

    ConstantPool pool = new ConstantPool();
    int accessFlags;
    int thisClass;
    int superClass;
    List<Integer> interfaces = new ArrayList<>();
    List<FieldInfo> fields = new ArrayList<>();
    List<MethodInfo> methods = new ArrayList<>();
    List<AttributeInfo> attributes = new ArrayList<>();

    static class FieldInfo {
        int accessFlags;
        int nameIndex;
        int descriptorIndex;
        List<AttributeInfo> attributes = new ArrayList<>();
    }

    static class MethodInfo {
        int accessFlags;
        int nameIndex;
        int descriptorIndex;
        List<AttributeInfo> attributes = new ArrayList<>();
        byte[] code;
    }

    static class AttributeInfo {
        int nameIndex;
        byte[] info;
    }

    /* 写 .class 文件 */
    byte[] write(String className, Klass k) throws IOException {
        ByteArrayOutputStream out = new ByteArrayOutputStream();
        DataOutputStream d = new DataOutputStream(out);

        d.writeInt(MAGIC);
        d.writeShort(MINOR);
        d.writeShort(MAJOR);

        /* 常量池 */
        d.writeShort(pool.entries.size() + 1);
        for (Object e : pool.entries) {
            if (e instanceof String) {
                d.writeByte(1);
                d.writeUTF((String) e);
            } else if (e instanceof Integer) {
                d.writeByte(3);
                d.writeInt((Integer) e);
            } else if (e instanceof int[]) {
                int[] arr = (int[]) e;
                d.writeByte(arr[0]);
                for (int i = 1; i < arr.length; i++) d.writeShort(arr[i]);
            }
        }

        /* 访问标志、类索引 */
        thisClass = pool.addClass(className);
        superClass = pool.addClass("java/lang/Object");
        d.writeShort(0x0021);
        d.writeShort(thisClass);
        d.writeShort(superClass);
        d.writeShort(interfaces.size());
        for (int i : interfaces) d.writeShort(i);

        /* 字段 */
        d.writeShort(fields.size());
        for (FieldInfo f : fields) {
            d.writeShort(f.accessFlags);
            d.writeShort(f.nameIndex);
            d.writeShort(f.descriptorIndex);
            d.writeShort(f.attributes.size());
        }

        /* 方法 */
        d.writeShort(methods.size());
        for (MethodInfo m : methods) {
            d.writeShort(m.accessFlags);
            d.writeShort(m.nameIndex);
            d.writeShort(m.descriptorIndex);
            d.writeShort(m.attributes.size());
            for (AttributeInfo a : m.attributes) {
                d.writeShort(a.nameIndex);
                d.writeInt(a.info.length);
                d.write(a.info);
            }
        }

        /* 类属性 */
        d.writeShort(attributes.size());
        for (AttributeInfo a : attributes) {
            d.writeShort(a.nameIndex);
            d.writeInt(a.info.length);
            d.write(a.info);
        }

        d.flush();
        return out.toByteArray();
    }

    /* 读 .class 文件 */
    static ClassFile read(byte[] data) throws IOException {
        DataInputStream d = new DataInputStream(new ByteArrayInputStream(data));
        ClassFile cf = new ClassFile();

        int magic = d.readInt();
        if (magic != MAGIC) throw new IOException("bad magic");
        d.readShort(); // minor
        d.readShort(); // major

        int cpCount = d.readUnsignedShort();
        for (int i = 1; i < cpCount; i++) {
            int tag = d.readUnsignedByte();
            switch (tag) {
                case 1: cf.pool.entries.add(d.readUTF()); break;
                case 3: cf.pool.entries.add(d.readInt()); break;
                case 7: cf.pool.entries.add(new int[]{7, d.readUnsignedShort()}); break;
                case 9: cf.pool.entries.add(new int[]{9, d.readUnsignedShort(), d.readUnsignedShort()}); break;
                case 10: cf.pool.entries.add(new int[]{10, d.readUnsignedShort(), d.readUnsignedShort()}); break;
                case 12: cf.pool.entries.add(new int[]{12, d.readUnsignedShort(), d.readUnsignedShort()}); break;
                default: throw new IOException("unknown cp tag: " + tag);
            }
        }

        cf.accessFlags = d.readUnsignedShort();
        cf.thisClass = d.readUnsignedShort();
        cf.superClass = d.readUnsignedShort();

        int ifCount = d.readUnsignedShort();
        for (int i = 0; i < ifCount; i++) cf.interfaces.add(d.readUnsignedShort());

        int fieldCount = d.readUnsignedShort();
        for (int i = 0; i < fieldCount; i++) {
            FieldInfo f = new FieldInfo();
            f.accessFlags = d.readUnsignedShort();
            f.nameIndex = d.readUnsignedShort();
            f.descriptorIndex = d.readUnsignedShort();
            int attrCount = d.readUnsignedShort();
            for (int j = 0; j < attrCount; j++) {
                AttributeInfo a = new AttributeInfo();
                a.nameIndex = d.readUnsignedShort();
                int len = d.readInt();
                a.info = new byte[len];
                d.readFully(a.info);
                f.attributes.add(a);
            }
            cf.fields.add(f);
        }

        int methodCount = d.readUnsignedShort();
        for (int i = 0; i < methodCount; i++) {
            MethodInfo m = new MethodInfo();
            m.accessFlags = d.readUnsignedShort();
            m.nameIndex = d.readUnsignedShort();
            m.descriptorIndex = d.readUnsignedShort();
            int attrCount = d.readUnsignedShort();
            for (int j = 0; j < attrCount; j++) {
                AttributeInfo a = new AttributeInfo();
                a.nameIndex = d.readUnsignedShort();
                int len = d.readInt();
                a.info = new byte[len];
                d.readFully(a.info);
                m.attributes.add(a);
                if (a.nameIndex == 0) m.code = a.info; // Code attribute
            }
            cf.methods.add(m);
        }

        int attrCount = d.readUnsignedShort();
        for (int i = 0; i < attrCount; i++) {
            AttributeInfo a = new AttributeInfo();
            a.nameIndex = d.readUnsignedShort();
            int len = d.readInt();
            a.info = new byte[len];
            d.readFully(a.info);
            cf.attributes.add(a);
        }

        return cf;
    }
}

