 * 第四部分：类系统 + 泛型
 * ============================================================ */

class Method {
    String name;
    int addr;
    int paramCount;
    String descriptor;
    List<String> typeParams = new ArrayList<>();
    Method(String name, int addr, int paramCount) {
        this.name = name; this.addr = addr; this.paramCount = paramCount;
    }
}

class Klass {
    String name;
    String parent;
    List<String> interfaces = new ArrayList<>();
    List<String> typeParams = new ArrayList<>();
    int size;
    Map<String, Method> methods = new HashMap<>();
    Map<String, Method> vtable = new HashMap<>();
    Map<String, Integer> fieldOffsets = new HashMap<>();
    Map<String, String> fieldDescriptors = new HashMap<>();
    List<Klass> innerClasses = new ArrayList<>();
    Map<String, Object> staticFields = new HashMap<>();
    int accessFlags = 0x0021; // ACC_PUBLIC | ACC_SUPER

    Klass(String name) { this.name = name; }

    void addMethod(String n, int a, int p) {
        Method m = new Method(n, a, p);
        methods.put(n, m);
        vtable.put(n, m);
    }

    void addField(String name) {
        fieldOffsets.put(name, size);
        fieldDescriptors.put(name, "I");
        size += 4;
    }

    Method findMethod(String n) { return methods.get(n); }
    Method findVirtual(String n) { return vtable.get(n); }

    void inherit(Klass parent) {
        this.parent = parent.name;
        this.size = parent.size;
        fieldOffsets.putAll(parent.fieldOffsets);
        fieldDescriptors.putAll(parent.fieldDescriptors);
        vtable.putAll(parent.vtable);
        interfaces.addAll(parent.interfaces);
    }

    Klass instantiate(List<String> args) {
        Klass k = new Klass(name + "<" + String.join(",", args) + ">");
        k.size = this.size;
        k.methods.putAll(this.methods);
        k.vtable.putAll(this.vtable);
        k.fieldOffsets.putAll(this.fieldOffsets);
        k.fieldDescriptors.putAll(this.fieldDescriptors);
        k.typeParams.addAll(args);
        return k;
    }
}

