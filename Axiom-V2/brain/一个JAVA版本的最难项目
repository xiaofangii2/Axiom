    INVOKEVIRTUAL, CHECKCAST, INSTANCEOF,
    THREAD_START, THREAD_JOIN, MONITOR_ENTER, MONITOR_EXIT,
    JIT_COMPILE,
    LAMBDA, INVOKEDYNAMIC, GENERIC_NEW, REFLECT_GET, REFLECT_SET,
    LOAD_CLASS, DEFINE_CLASS,
    LIST_NEW, LIST_ADD, LIST_GET, LIST_SIZE, LIST_REMOVE,
