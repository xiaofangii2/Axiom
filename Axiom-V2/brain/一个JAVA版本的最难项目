}

class Instr {
    Op op;
    int operand;
    String str;
    Instr(Op op, int operand) { this.op = op; this.operand = operand; }
    Instr(Op op) { this(op, 0); }
    Instr(Op op, String s) { this.op = op; this.str = s; }
}

/* ============================================================
 * 第三部分：词法分析
 * ============================================================ */

enum Tok {
    NUM, STR, IDENT, PLUS, MINUS, STAR, SLASH, PERCENT,
    EQ, EQEQ, NE, LT, LE, GT, GE,
    SEMI, LPAREN, RPAREN, LBRACE, RBRACE, LBRACKET, RBRACKET,
    COMMA, DOT, COLON, ARROW,
    INT, VOID, IF, ELSE, WHILE, RETURN, PRINT, CLASS, NEW, EOF,
    TRY, CATCH, THROW, FINALLY, INTERFACE, IMPLEMENTS, EXTENDS,
    THREAD, SYNCHRONIZED,
    GENERIC, LAMBDA, REFLECT, LOADER,
    LIST, MAP, SET, IO, NET,
    CLASSDEF, FIELD, METHOD
}

class Token {
    Tok kind;
    int val;
    String name;
    Token(Tok k) { kind = k; }
}

class Lexer {
    String src;
    int pos;
    Lexer(String s) { src = s; pos = 0; }

    void skipWs() {
        while (pos < src.length()) {
            char c = src.charAt(pos);
            if (Character.isWhitespace(c)) { pos++; continue; }
            if (c == '/' && pos + 1 < src.length() && src.charAt(pos+1) == '/') {
                while (pos < src.length() && src.charAt(pos) != '\n') pos++;
                continue;
            }
            break;
        }
    }

    Token next() {
        skipWs();
        if (pos >= src.length()) return new Token(Tok.EOF);
        char c = src.charAt(pos);

        if (Character.isDigit(c)) {
            int v = 0;
            while (pos < src.length() && Character.isDigit(src.charAt(pos))) {
                v = v * 10 + (src.charAt(pos) - '0');
                pos++;
            }
            Token t = new Token(Tok.NUM);
            t.val = v;
            return t;
        }

        if (c == '"') {
            pos++;
            StringBuilder sb = new StringBuilder();
            while (pos < src.length() && src.charAt(pos) != '"') {
                if (src.charAt(pos) == '\\' && pos + 1 < src.length()) {
                    pos++;
                    char e = src.charAt(pos);
                    if (e == 'n') sb.append('\n');
                    else if (e == 't') sb.append('\t');
                    else sb.append(e);
                } else sb.append(src.charAt(pos));
                pos++;
            }
            pos++;
            Token t = new Token(Tok.STR);
            t.name = sb.toString();
            return t;
        }

        if (Character.isLetter(c) || c == '_') {
            int start = pos;
            while (pos < src.length() &&
                   (Character.isLetterOrDigit(src.charAt(pos)) || src.charAt(pos) == '_')) pos++;
            String name = src.substring(start, pos);
            Token t = new Token(Tok.IDENT);
            t.name = name;
            switch (name) {
                case "int": t.kind = Tok.INT; break;
                case "void": t.kind = Tok.VOID; break;
                case "if": t.kind = Tok.IF; break;
                case "else": t.kind = Tok.ELSE; break;
                case "while": t.kind = Tok.WHILE; break;
                case "return": t.kind = Tok.RETURN; break;
                case "print": t.kind = Tok.PRINT; break;
                case "class": t.kind = Tok.CLASS; break;
                case "new": t.kind = Tok.NEW; break;
                case "try": t.kind = Tok.TRY; break;
                case "catch": t.kind = Tok.CATCH; break;
                case "throw": t.kind = Tok.THROW; break;
                case "finally": t.kind = Tok.FINALLY; break;
                case "interface": t.kind = Tok.INTERFACE; break;
                case "implements": t.kind = Tok.IMPLEMENTS; break;
                case "extends": t.kind = Tok.EXTENDS; break;
                case "thread": t.kind = Tok.THREAD; break;
                case "synchronized": t.kind = Tok.SYNCHRONIZED; break;
                case "generic": t.kind = Tok.GENERIC; break;
                case "lambda": t.kind = Tok.LAMBDA; break;
                case "reflect": t.kind = Tok.REFLECT; break;
                case "loader": t.kind = Tok.LOADER; break;
                case "list": t.kind = Tok.LIST; break;
                case "map": t.kind = Tok.MAP; break;
                case "set": t.kind = Tok.SET; break;
                case "io": t.kind = Tok.IO; break;
                case "net": t.kind = Tok.NET; break;
                case "classdef": t.kind = Tok.CLASSDEF; break;
                case "field": t.kind = Tok.FIELD; break;
                case "method": t.kind = Tok.METHOD; break;
            }
            return t;
        }

        pos++;
        switch (c) {
            case '+': return new Token(Tok.PLUS);
            case '-':
                if (pos < src.length() && src.charAt(pos) == '>') { pos++; return new Token(Tok.ARROW); }
                return new Token(Tok.MINUS);
            case '*': return new Token(Tok.STAR);
            case '/': return new Token(Tok.SLASH);
            case '%': return new Token(Tok.PERCENT);
            case ';': return new Token(Tok.SEMI);
            case '(': return new Token(Tok.LPAREN);
            case ')': return new Token(Tok.RPAREN);
            case '{': return new Token(Tok.LBRACE);
            case '}': return new Token(Tok.RBRACE);
            case '[': return new Token(Tok.LBRACKET);
            case ']': return new Token(Tok.RBRACKET);
            case ',': return new Token(Tok.COMMA);
            case '.': return new Token(Tok.DOT);
            case ':': return new Token(Tok.COLON);
            case '=':
                if (pos < src.length() && src.charAt(pos) == '=') { pos++; return new Token(Tok.EQEQ); }
                return new Token(Tok.EQ);
            case '!':
                if (pos < src.length() && src.charAt(pos) == '=') { pos++; return new Token(Tok.NE); }
                throw new RuntimeException("unknown char: !");
            case '<':
                if (pos < src.length() && src.charAt(pos) == '=') { pos++; return new Token(Tok.LE); }
                return new Token(Tok.LT);
            case '>':
                if (pos < src.length() && src.charAt(pos) == '=') { pos++; return new Token(Tok.GE); }
                return new Token(Tok.GT);
        }
        throw new RuntimeException("unknown char: " + c);
    }

    List<Token> tokenize() {
        List<Token> list = new ArrayList<>();
        Token t;
        do { t = next(); list.add(t); } while (t.kind != Tok.EOF);
        return list;
    }
}

